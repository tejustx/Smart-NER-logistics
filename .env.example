# Supabase Direct PostgreSQL Connection String
# You can find this in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Option A: Connection Pooler (Recommended for cloud/serverless/IPv4):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# Option B: Direct Connection (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
#
# If DATABASE_URL is left empty or commented out, the application will automatically 
# use a local SQLite database for development and offline testing.
DATABASE_URL=""

# Optional Secret Keys
APP_SECRET_KEY="ner-logistics-mountain-secret-key-2026"

